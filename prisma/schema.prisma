generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentProfile {
  id                 String   @id @default(cuid())
  name               String
  currentDegree      String
  targetIntake       String
  budgetCeilingUsd   Int
  careerNorthStar    String
  createdAt          DateTime @default(now())
  applications       Application[]
  scholarships       Scholarship[]
  notes              Note[]
}

model Application {
  id                     String   @id @default(cuid())
  studentProfileId       String
  studentProfile         StudentProfile @relation(fields: [studentProfileId], references: [id])
  university             String
  country                String
  city                   String
  program                String
  status                 String
  deadline               DateTime
  tuitionUsd             Int
  livingCostUsd          Int
  rentUsd                Int
  admissionProbability   Int
  scholarshipProbability Int
  aiVerdict              String
  documents              Document[]
}

model Scholarship {
  id               String   @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  country          String
  valueUsd         Int
  deadline         DateTime
  fitScore         Int
  strategy         String
}

model Document {
  id            String @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  name          String
  type          String
  status        String
  version       Int    @default(1)
}

model Note {
  id               String   @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])
  title            String
  body             String
  tags             String[]
  createdAt        DateTime @default(now())
}
